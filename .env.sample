# Example .env for staging/local deployments
# Copy to .env and edit secrets before running docker-compose

# App
APP_NAME=Pengwin
SECRET_KEY=change-this-in-production
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080

# Database (Postgres)
POSTGRES_USER=pengwin
POSTGRES_PASSWORD=pengwinpass
POSTGRES_DB=pengwin
DATABASE_URL=postgresql+psycopg://pengwin:pengwinpass@db:5432/pengwin

# Analytics snapshot path (DBFS or local path mounted into container)
ANALYTICS_BATCH_SNAPSHOT_PATH=/data/recommendations/recommendations_snapshot.json

# LLM (example)
LLM_PROVIDER=groq
LLM_API_KEY=
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_MODEL=llama-3.1-8b-instant
LLM_TIMEOUT_SECONDS=30
